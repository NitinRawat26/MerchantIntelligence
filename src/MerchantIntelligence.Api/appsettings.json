{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kyb": {
    "UserAgent": "MerchantIntelligence/1.0 (+https://github.com/NitinRawat26/MerchantIntelligence)",
    "OpenCorporatesApiToken": null,
    "CompaniesHouseApiKey": null,
    "FoursquareApiKey": null,
    "GooglePlacesApiKey": null,
    "LocalPresenceEnabled": true
  },
  "Sanctions": {
    "CacheDirectory": "data/sanctions",
    "RefreshInterval": "1.00:00:00",
    "MatchThreshold": 0.85,
    "IncludePeps": false,
    "IncludeRawGovernmentLists": true,
    "EnableAdverseMedia": true,
    "AdverseMediaSources": [ "gdelt", "googlenews", "bingnews", "wikipedia", "courtlistener" ]
  }
}
