{
  "name": "Standard onboarding",
  "version": "default",
  "description": "Every deterministic check, grouped under five rule-based agents. Profile classifies the applicant first and scopes the run; Pre-check, KYB and Financial then gather evidence in parallel; Decision & case closes.",
  "haltOnHardStop": false,
  "agents": [
    { "id": "profile", "enabled": true, "stepOrder": "Parallel", "steps": ["entity", "segment"] },
    { "id": "precheck", "enabled": true, "stepOrder": "Parallel", "steps": ["website", "prohibited", "mcc"] },
    { "id": "kyb", "enabled": true, "stepOrder": "Parallel", "steps": ["verification", "screening", "match", "presence"] },
    { "id": "financial", "enabled": true, "stepOrder": "Parallel", "steps": ["bank", "financials", "plausibility", "credit"] },
    { "id": "decision", "enabled": true, "stepOrder": "Parallel", "steps": ["terms", "score", "case"] }
  ],
  "transitions": [
    { "from": "precheck", "to": "decision", "when": "Always" },
    { "from": "kyb", "to": "financial", "when": "Always" },
    { "from": "kyb", "to": "decision", "when": "Always" },
    { "from": "financial", "to": "decision", "when": "Always" }
  ],
  "steps": [
    { "id": "entity", "enabled": true, "onFail": "Skip" },
    { "id": "segment", "enabled": true, "onFail": "Skip" },
    { "id": "verification", "enabled": true, "onFail": "Skip" },
    { "id": "screening", "enabled": true, "onFail": "Skip" },
    { "id": "website", "enabled": true, "onFail": "Skip" },
    { "id": "prohibited", "enabled": true, "onFail": "Skip" },
    { "id": "mcc", "enabled": true, "onFail": "Skip" },
    { "id": "match", "enabled": true, "onFail": "Skip" },
    { "id": "presence", "enabled": true, "onFail": "Skip" },
    { "id": "bank", "enabled": true, "onFail": "Skip" },
    { "id": "financials", "enabled": true, "onFail": "Skip" },
    { "id": "plausibility", "enabled": true, "onFail": "Skip" },
    { "id": "credit", "enabled": true, "onFail": "Skip" },
    { "id": "terms", "enabled": true, "onFail": "Skip" },
    { "id": "score", "enabled": true, "onFail": "Skip" },
    { "id": "case", "enabled": true, "onFail": "Skip" }
  ]
}
